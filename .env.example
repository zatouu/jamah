# Modèle de variables d'environnement — copier vers `.env` et remplir.
# Ne jamais committer de valeurs réelles.

# --- PostgreSQL (base du CMS) ---
POSTGRES_DB=jamah
POSTGRES_USER=jamah
POSTGRES_PASSWORD=change-me

# --- Directus (CMS headless) ---
# Générer des valeurs aléatoires longues, ex. : openssl rand -hex 32
DIRECTUS_SECRET=change-me
DIRECTUS_ADMIN_EMAIL=admin@example.org
DIRECTUS_ADMIN_PASSWORD=change-me
DIRECTUS_PUBLIC_URL=http://localhost:8055

# --- Elasticsearch ---
# Mémoire allouée à la JVM en développement
ES_JAVA_OPTS=-Xms512m -Xmx512m

# --- Search Service (FastAPI) ---
SEARCH_ES_URL=http://elasticsearch:9200
SEARCH_INDEX_PREFIX=jamah
# Jeton partagé pour les webhooks d'indexation Directus -> Search Service
SEARCH_INDEX_TOKEN=change-me
# Modèle sémantique multilingue (vide = mot à mot seul). ~0,5 Go en mémoire, CPU.
SEARCH_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Site public (Next.js) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# URL du Search Service vue depuis le serveur Next.js
SEARCH_API_URL=http://localhost:8000
# URL du CMS vue depuis le serveur Next.js
CMS_URL=http://localhost:8055
# Jeton partagé Directus -> site pour régénérer les pages après une publication (openssl rand -hex 32)
REVALIDATE_TOKEN=change-me
