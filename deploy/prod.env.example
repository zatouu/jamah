# Variables de production — copiées par setup-vm.sh vers /opt/jamah/.env (secrets générés), puis à compléter.
# Ne jamais committer le fichier rempli.

# Domaines (DNS de type A vers l'IP élastique de la VM). Sans domaine : <nom>.<ip-avec-tirets>.sslip.io
SITE_DOMAIN=jamah.example.org
CMS_DOMAIN=cms.jamah.example.org
# Courriel pour Let's Encrypt (alertes d'expiration)
ACME_EMAIL=admin@example.org

POSTGRES_DB=jamah
POSTGRES_USER=jamah
POSTGRES_PASSWORD=__RANDOM__

DIRECTUS_SECRET=__RANDOM__
DIRECTUS_ADMIN_EMAIL=admin@example.org
DIRECTUS_ADMIN_PASSWORD=__RANDOM__

REVALIDATE_TOKEN=__RANDOM__

# Image du site publiée par GitHub Actions (WEB_TAG est fixé à chaque déploiement)
WEB_IMAGE=ghcr.io/zatouu/jamah-web
WEB_TAG=latest

# --- 2e partie : recherche ---
# COMPOSE_PROFILES=search
# SEARCH_API_URL=http://search:8000
SEARCH_INDEX_TOKEN=__RANDOM__
ES_JAVA_OPTS=-Xms512m -Xmx512m
SEARCH_EMBEDDING_MODEL=
