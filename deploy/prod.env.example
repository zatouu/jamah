# Référence des variables de production. Le vrai /opt/jamah/.env est écrit par le workflow Deploy
# à chaque déploiement (ne pas le modifier sur la VM) ; ce fichier sert à la vérification du compose en CI.
# Source de vérité : environnement GitHub « production » (gh variable set / gh secret set … -e production).

# Variable SITE_URL (https://<SITE_DOMAIN>) ; sans domaine : <nom>.<ip-avec-tirets>.sslip.io
SITE_DOMAIN=jamah.example.org
# Variables CMS_DOMAIN, ACME_EMAIL (Let's Encrypt refuse example.org), DIRECTUS_ADMIN_EMAIL
CMS_DOMAIN=cms.jamah.example.org
ACME_EMAIL=admin@example.org

POSTGRES_DB=jamah
POSTGRES_USER=jamah
# Secrets. POSTGRES_PASSWORD et DIRECTUS_ADMIN_PASSWORD ne sont lus qu'à l'initialisation :
# les changer ensuite exige aussi ALTER USER (Postgres) / changement dans Directus.
POSTGRES_PASSWORD=change-me
DIRECTUS_SECRET=change-me
DIRECTUS_ADMIN_EMAIL=admin@example.org
DIRECTUS_ADMIN_PASSWORD=change-me
REVALIDATE_TOKEN=change-me
SEARCH_INDEX_TOKEN=change-me

# Fixés par le workflow (image construite pour ce déploiement)
WEB_IMAGE=ghcr.io/zatouu/jamah-web
WEB_TAG=latest

# --- 2e partie : recherche (variables COMPOSE_PROFILES=search, SEARCH_API_URL=http://search:8000) ---
COMPOSE_PROFILES=
SEARCH_API_URL=
ES_JAVA_OPTS=-Xms512m -Xmx512m
SEARCH_EMBEDDING_MODEL=
