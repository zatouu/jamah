# Image d'exécution légère : le build Next.js (standalone) est fait hors de la VM.
# Contexte attendu : ./standalone (= .next/standalone + .next/static + public)
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
COPY standalone/ ./
# sharp (optimisation d'images) pour linux/musl de l'architecture cible
RUN mkdir /tmp/sharp && cd /tmp/sharp && npm init -y >/dev/null \
  && npm install --no-audit --no-fund sharp@0.34.5 \
  && cp -r node_modules/. /app/node_modules/ && rm -rf /tmp/sharp /root/.npm \
  && addgroup -S app && adduser -S app -G app && chown -R app:app /app/.next
USER app
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1:3000/fr >/dev/null || exit 1
CMD ["node", "server.js"]
